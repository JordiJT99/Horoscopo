
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla por defecto: denegar todo para forzar reglas explícitas.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HORÓSCOPOS GLOBALES ---
    // Lectura pública, escritura prohibida (solo desde Admin SDK / Backend)
    match /horoscopes/{period}/{dateKey}/{locale} {
      allow read: if true;
      allow write: if false;
    }

    // --- HORÓSCOPOS PERSONALIZADOS ---
    // Solo el propietario puede leer y escribir sus propios datos
    match /horoscopes/personalized/{date}/{locale}/{sign}/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- COMUNIDAD ---
    match /community-posts/{postId} {
      // Lectura pública
      allow read: if true;
      
      // Creación: Usuario autenticado y authorId debe coincidir con su UID
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.authorId;
      
      // Update/Delete: Solo el autor original
      allow update, delete: if request.auth != null 
                            && request.auth.uid == resource.data.authorId;

      // Subcolección de Comentarios
      match /comments/{commentId} {
        // Lectura: Usuarios autenticados
        allow read: if request.auth != null;

        // Creación: Usuario autenticado y authorId debe coincidir con su UID
        allow create: if request.auth != null 
                      && request.auth.uid == request.resource.data.authorId;
        
        // Update/Delete: Solo el autor del comentario
        allow update, delete: if request.auth != null 
                              && request.auth.uid == resource.data.authorId;
      }
    }
    
    // --- PERFILES DE USUARIO ---
    match /userProfiles/{userId} {
      // Lectura pública (para avatares, nombres en la comunidad)
      allow read: if true;
      
      // Escritura: Solo el propietario
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- TOKENS DE NOTIFICACIÓN (FCM) ---
    // Solo el usuario puede gestionar su propio token
    match /fcmTokens/{token} {
      allow create, update: if request.auth != null 
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      allow read: if false; // Nadie puede listar los tokens
    }
  }
}
