# Variables de entorno para la configuración de Firebase
# Asegúrate de que estos valores corresponden a tu proyecto Firebase "astrovibes-xvf24"

# Obligatorio: Clave API de tu proyecto Firebase.
# Encuéntrala en Firebase Console > Configuración del proyecto > General > Tus apps > SDK de Firebase (fragmento de configuración).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAFcU4zO3c1blID2o5325izATM2n24pFgQ

# Obligatorio: Dominio de autenticación de tu proyecto Firebase.
# Encuéntralo en Firebase Console > Configuración del proyecto > General > Tus apps > SDK de Firebase (fragmento de configuración).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=astrovibes-xv2f4.firebaseapp.com

# Obligatorio: ID del proyecto Firebase.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=astrovibes-xv2f4

# Opcional, pero recomendado: Bucket de almacenamiento de Firebase.
# Encuéntralo en Firebase Console > Configuración del proyecto > General > Tus apps > SDK de Firebase (fragmento de configuración).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=astrovibes-xv2f4.firebasestorage.app
# Opcional, pero recomendado: ID del remitente de Firebase Messaging.
# Encuéntralo en Firebase Console > Configuración del proyecto > General > Tus apps > SDK de Firebase (fragmento de configuración).
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=987225861422

# Obligatorio: ID de la aplicación Firebase.
# Encuéntralo en Firebase Console > Configuración del proyecto > General > Tus apps > SDK de Firebase (fragmento de configuración).
NEXT_PUBLIC_FIREBASE_APP_ID=1:987225861422:web:db77b5ad6fa16aa74e1ebf

# Opcional: ID de medición de Google Analytics para Firebase.
# Si usas Analytics, encuéntralo en Firebase Console > Configuración del proyecto > Integraciones > Google Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-N4QJT0HS39

# Variable para Genkit (Asegúrate de que esta es la clave API correcta para los servicios de IA que usas)
# Esta clave podría ser diferente de la de Firebase, dependiendo de cómo uses Genkit y Google AI.
# Obtén una API Key de Google AI Studio (anteriormente MakerSuite): https://makersuite.google.com/app/apikey
# 🚨 CLAVE ANTERIOR COMPROMETIDA - CONSUMO NO AUTORIZADO
# GOOGLE_API_KEY=AIzaSyD2hUUSuiZZLY2Vcenwe5q5ZchHFIxHGZI
GOOGLE_API_KEY=AIzaSyDQrEzLVu8gtrdE3QDWnon-cXy2SMPMHe8

# 🛡️ CONFIGURACIÓN DE SEGURIDAD: Forzar modelo específico
GENKIT_MODEL=googleai/gemini-2.0-flash
GENKIT_FALLBACK_DISABLED=true
ALLOWED_AI_MODELS=googleai/gemini-2.0-flash

#GEMINI_API_KEY=AIzaSyAJ_Wq3acpj1wdHpRTlfhdvp4XUUvO6wbo
GEMINI_API_KEY=

# Firebase Admin SDK - Clave de cuenta de servicio
# Ruta al archivo JSON de la cuenta de servicio de Firebase Admin
# El archivo se descarga desde Firebase Console > Configuración > Cuentas de servicio > Generar nueva clave privada
APP_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# Firebase Cloud Messaging - VAPID Key para Web Push Notifications
# Obtén la clave desde Firebase Console > Configuración del proyecto > Cloud Messaging > Certificados Push Web > Par de claves
# ⚠️ IMPORTANTE: Genera o copia tu clave VAPID y pégala aquí para habilitar las notificaciones push
NEXT_PUBLIC_FIREBASE_VAPID_KEY=