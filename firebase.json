{
  "hosting": {
    "target": "astromistica-org",
    "public": ".next",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "nextjsFunc"
      }
    ]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      ".git",
      ".github",
      "android",
      "src",
      ".env.local",
      "*.md",
      "*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}